# 이 파일을 .dev.vars로 복사한 뒤 실제 값을 입력하세요.
# .dev.vars는 .gitignore에 포함되어 Git에 올라가지 않습니다.

BASE_URL="http://localhost:8787"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
SESSION_SECRET="REPLACE_ME_WITH_A_RANDOM_VALUE"

# 선택 설정
APP_NAME="Private Board"
REGISTRATION_MODE="open"
ALLOWED_EMAILS=""
ALLOWED_DOMAINS=""
ADMIN_EMAILS=""
SESSION_DAYS="14"
CONTACT_EMAIL="operator@example.com"

# Turnstile을 사용할 때 두 값을 모두 입력하세요. 비워 두면 사용하지 않습니다.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# R2 직접 업로드. 비워 두면 이미지 업로드 시 설정 안내 토스트만 표시됩니다.
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
